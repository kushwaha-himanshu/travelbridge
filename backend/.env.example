# Node.js Express Backend Configuration
PORT=8001
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/travelbridge

# Python AI Trip Planner Microservice Configuration
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TOKEN=your_internal_service_token_optional

# JWT & Authentication
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

# External AI & API Keys (Server-side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_optional
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_optional
STAYING_API_KEY=your_staying_api_key_optional
GROQ_API_KEY=your_groq_api_key_optional
TAVILY_API_KEY=your_tavily_api_key_optional

# Razorpay Payments (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
